{
    "app-id": "dev.linwood.butterfly",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "butterfly",
    "separate-locales": false,
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--share=network",
        "--talk-name=org.freedesktop.secrets",
        "--system-talk-name=org.freedesktop.NetworkManager",
        "--filesystem=xdg-documents/Linwood/Butterfly:create"
    ],
    "modules": [
        {
            "name": "libjsoncpp",
            "buildsystem": "meson",
            "config-opts": [
                "--buildtype=release",
                "--default-library=shared"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/open-source-parsers/jsoncpp/archive/refs/tags/1.9.8.tar.gz",
                    "sha256": "51828cf3574281d2b79ec2a1c56a9e4c20cc1103711321ea96384cffb8d2d904",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/open-source-parsers/jsoncpp/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": ".tarball_url"
                    }
                }
            ]
        },
        {
            "name": "butterfly",
            "buildsystem": "simple",
            "build-commands": [
                "cp -r FlutterApp /app/",
                "chmod +x /app/FlutterApp/butterfly",
                "mkdir -p /app/bin",
                "ln -s /app/FlutterApp/butterfly /app/bin/butterfly",
                "install -Dm644 dev.linwood.butterfly.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/dev.linwood.butterfly.svg",
                "install -Dm644 /app/FlutterApp/usr/share/metainfo/dev.linwood.butterfly.appdata.xml ${FLATPAK_DEST}/share/metainfo/${FLATPAK_ID}.metainfo.xml",
                "install -Dm644 /app/FlutterApp/usr/share/applications/dev.linwood.butterfly.desktop -t ${FLATPAK_DEST}/share/applications/",
                "install -Dm644 /app/FlutterApp/usr/share/mime/packages/dev.linwood.butterfly.xml ${FLATPAK_DEST}/share/mime/packages/${FLATPAK_ID}.xml"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "icons/dev.linwood.butterfly.svg"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/LinwoodDev/Butterfly/releases/download/v2.6.0-rc.0/linwood-butterfly-linux-x86_64.tar.gz",
                    "sha256": "38e61eb8f7d27d36b51185e61724fdc41cdfe4b3c5e4e5c1235789388189e46e",
                    "dest": "FlutterApp",
                    "only-arches": ["x86_64"],
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/LinwoodDev/Butterfly/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name==\"linwood-butterfly-linux-x86_64.tar.gz\") | .browser_download_url"
                    }
                },
                {
                    "type": "archive",
                    "url": "https://github.com/LinwoodDev/Butterfly/releases/download/v2.6.0-rc.0/linwood-butterfly-linux-arm64.tar.gz",
                    "sha256": "8dbf506a0bdab87a7f4fdba49aa5b9bb7b5ac94680a56724463e51da0735b991",
                    "dest": "FlutterApp",
                    "only-arches": ["aarch64"],
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/LinwoodDev/Butterfly/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name==\"linwood-butterfly-linux-arm64.tar.gz\") | .browser_download_url"
                    }
                }
            ]
        }
    ]
}
