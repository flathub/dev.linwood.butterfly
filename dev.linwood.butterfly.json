{
    "app-id": "dev.linwood.butterfly",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "butterfly",
    "separate-locales": false,
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--share=network",
        "--talk-name=org.freedesktop.secrets",
        "--system-talk-name=org.freedesktop.NetworkManager",
        "--filesystem=xdg-documents/Linwood/Butterfly:create"
    ],
    "modules": [
        {
            "name": "libjsoncpp",
            "buildsystem": "meson",
            "config-opts": [
                "--buildtype=release",
                "--default-library=shared",
                "-Dtests=disabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/open-source-parsers/jsoncpp/archive/refs/tags/1.9.8.tar.gz",
                    "sha256": "82fce31c882fa4fc82dff10abbf4e7831cfff1a6a3c0ce4a5d503b8e41c20da6",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/open-source-parsers/jsoncpp/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": ".tarball_url"
                    }
                }
            ]
        },
        {
            "name": "butterfly",
            "buildsystem": "simple",
            "build-commands": [
                "cp -r FlutterApp/* /app/",
                "chmod +x /app/bin/butterfly",
                "install -Dm644 dev.linwood.butterfly.svg ${FLATPAK_DEST}/share/icons/hicolor/scalable/apps/dev.linwood.butterfly.svg",
                "install -Dm644 /app/share/metainfo/dev.linwood.butterfly.appdata.xml ${FLATPAK_DEST}/share/metainfo/${FLATPAK_ID}.appdata.xml",
                "install -Dm644 /app/share/applications/dev.linwood.butterfly.desktop ${FLATPAK_DEST}/share/applications/${FLATPAK_ID}.desktop",
                "install -Dm644 /app/share/mime/packages/dev.linwood.butterfly.xml ${FLATPAK_DEST}/share/mime/packages/${FLATPAK_ID}.xml"
            ],
            "sources": [
                {
                    "type": "file",
                    "path": "icons/dev.linwood.butterfly.svg"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/LinwoodDev/Butterfly/releases/download/v2.6.0-beta.6/linwood-butterfly-linux-x86_64.tar.gz",
                    "sha256": "93eb9a63727c15029c90a4dadec5e3735e413a0807bf10d4197dec79a86ee1eb",
                    "dest": "FlutterApp",
                    "only-arches": ["x86_64"],
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/LinwoodDev/Butterfly/releases/latest",
                        "version-query": ".tag_name | ltrimstr(\"v\")",
                        "url-query": ".assets[] | select(.name==\"linwood-butterfly-linux-x86_64.tar.gz\") | .browser_download_url"
                    }
                },
                {
                    "type": "archive",
                    "url": "https://github.com/LinwoodDev/Butterfly/releases/download/v2.6.0-beta.6/linwood-butterfly-linux-arm64.tar.gz",
                    "sha256": "57dbbcbbdeec2f7211de7d8f56d1fc8b1e4d858cac4cee6ad50aef2be4b3c5c8",
                    "dest": "FlutterApp",
                    "only-arches": ["aarch64"],
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/LinwoodDev/Butterfly/releases/latest",
                        "version-query": ".tag_name | ltrimstr(\"v\")",
                        "url-query": ".assets[] | select(.name==\"linwood-butterfly-linux-arm64.tar.gz\") | .browser_download_url"
                    }
                }
            ]
        }
    ]
}
